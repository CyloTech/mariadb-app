[mariadb]
port            = 3306
socket          = /run/mysqld/mysqld.sock

# InnoDB settings for container environments
innodb_flush_method = littlesync
innodb_use_native_aio = OFF

# Binary logging (disable if not using replication)
# log_bin = mariadb-bin

# Character set defaults (utf8mb4 recommended for modern applications)
character-set-server = utf8mb4
collation-server = utf8mb4_general_ci